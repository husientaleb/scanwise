# ScanWise environment variables (server-side only — never shipped to the client).
# Copy to your Vercel project settings (Settings → Environment Variables).

# Enables /api/analyze (vision-capable AI label analysis).
# Without it, the app still works using its built-in rule-based analyzer.
ANTHROPIC_API_KEY=

# Future: Supabase auth + synced history (see supabase/schema.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Future: Stripe billing for ScanWise Plus. Billing stays inert until set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
